generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model branch {
  branchID         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar
  address          String?            @db.VarChar
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  deliveries       deliveries[]
  inventory        inventory[]
  purchase_orders  purchase_orders[]
  restock_requests restock_requests[]
  sales            sales[]
  stock_movements  stock_movements[]
  users            users[]
}

model deliveries {
  deliveryID      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderID         String          @db.Uuid
  branchID        String          @db.Uuid
  received_by     String?         @db.Uuid
  received_at     DateTime?       @db.Timestamptz(6)
  branch          branch          @relation(fields: [branchID], references: [branchID], onUpdate: NoAction)
  purchase_orders purchase_orders @relation(fields: [orderID], references: [orderID], onUpdate: NoAction)
  users           users?          @relation(fields: [received_by], references: [userID], onUpdate: NoAction)
  delivery_items   delivery_items []

  @@index([branchID])
  @@index([orderID])
  @@index([received_by])
}

model delivery_items {
  delivery_itemID   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryID        String     @db.Uuid
  productID         String     @db.Uuid
  quantity_received Int
  deliveries        deliveries @relation(fields: [deliveryID], references: [deliveryID], onDelete: Cascade, onUpdate: NoAction)
  products          products   @relation(fields: [productID], references: [productID], onUpdate: NoAction)

  @@index([deliveryID])
  @@index([productID])
}

model inventory {
  inventoryID       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productID         String   @db.Uuid
  branchID          String   @db.Uuid
  quantity          Int      @default(0)
  reorder_threshold Int      @default(0)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  branch            branch   @relation(fields: [branchID], references: [branchID], onDelete: Cascade, onUpdate: NoAction)
  products          products @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productID, branchID])
  @@index([branchID])
  @@index([productID])
}

model products {
  productID            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                  String                 @unique @db.VarChar
  name                 String                 @db.VarChar
  unit_cost            Decimal                @db.Decimal
  unit_price           Decimal                @db.Decimal
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  delivery_items        delivery_items[]
  inventory            inventory[]
  purchase_order_items purchase_order_items[]
  restock_requests     restock_requests[]
  sale_items           sale_items[]
  stock_movements      stock_movements[]
}


model purchase_order_items {
  purchase_itemID  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderID          String          @db.Uuid
  productID        String          @db.Uuid
  quantity_ordered Int
  unit_cost        Decimal         @db.Decimal
  purchase_orders  purchase_orders @relation(fields: [orderID], references: [orderID], onDelete: Cascade, onUpdate: NoAction)
  products         products        @relation(fields: [productID], references: [productID], onUpdate: NoAction)

  @@index([orderID])
  @@index([productID])
}


model purchase_orders {
  orderID              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierID           String                 @db.Uuid
  branchID             String                 @db.Uuid
  requestID            String?                @db.Uuid
  status               String                 @default("open") @db.VarChar
  created_by           String                 @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  deliveries           deliveries[]
  purchase_order_items purchase_order_items[]
  branch               branch                 @relation(fields: [branchID], references: [branchID], onUpdate: NoAction)
  users                users                  @relation(fields: [created_by], references: [userID], onUpdate: NoAction)
  restock_requests     restock_requests?      @relation(fields: [requestID], references: [requestID], onUpdate: NoAction)
  suppliers            suppliers              @relation(fields: [supplierID], references: [supplierID], onUpdate: NoAction)

  @@index([branchID])
  @@index([created_by])
  @@index([requestID])
  @@index([supplierID])
}

model restock_requests {
  requestID       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productID       String            @db.Uuid
  branchID        String            @db.Uuid
  request_qty     Int
  status          String            @default("pending") @db.VarChar
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  approved_by     String?           @db.Uuid
  approved_at     DateTime?         @db.Timestamptz(6)
  purchase_orders purchase_orders[]
  users           users?            @relation(fields: [approved_by], references: [userID], onUpdate: NoAction)
  branch          branch            @relation(fields: [branchID], references: [branchID], onDelete: Cascade, onUpdate: NoAction)
  products        products          @relation(fields: [productID], references: [productID], onUpdate: NoAction)

  @@index([approved_by])
  @@index([branchID])
  @@index([productID])
}

model roles {
  roleID    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_name String  @unique @db.VarChar
  users     users[]
}


model sale_items {
  itemID     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleID     String   @db.Uuid
  productID  String   @db.Uuid
  quantity   Int
  unit_price Decimal  @db.Decimal
  products   products @relation(fields: [productID], references: [productID], onUpdate: NoAction)
  sales      sales    @relation(fields: [saleID], references: [saleID], onDelete: Cascade, onUpdate: NoAction)

  @@index([productID])
  @@index([saleID])
}

model sales {
  saleID       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashierID    String       @db.Uuid
  branchID     String       @db.Uuid
  total_amount Decimal      @default(0) @db.Decimal
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  sale_items   sale_items[]
  branch       branch       @relation(fields: [branchID], references: [branchID], onUpdate: NoAction)
  users        users        @relation(fields: [cashierID], references: [userID], onUpdate: NoAction)

  @@index([branchID])
  @@index([cashierID])
}


model stock_movements {
  movementID   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productID    String   @db.Uuid
  branchID     String   @db.Uuid
  change_qty   Int
  reference_id String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  reason       String   @db.VarChar
  actor_id     String?  @db.Uuid
  users        users?   @relation(fields: [actor_id], references: [userID], onUpdate: NoAction)
  branch       branch   @relation(fields: [branchID], references: [branchID], onDelete: Cascade, onUpdate: NoAction)
  products     products @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_id])
  @@index([branchID])
  @@index([productID])
}

model suppliers {
  supplierID      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar
  contact_info    String?           @db.VarChar
  purchase_orders purchase_orders[]
}

model users {
  userID           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName         String            @db.VarChar
  middleName         String?           @db.VarChar
  lastName         String             @db.VarChar
  email            String             @unique @db.VarChar
  password_hash    String
  roleID           String             @db.Uuid
  branchID         String?            @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  deliveries       deliveries[]
  purchase_orders  purchase_orders[]
  restock_requests restock_requests[]
  sales            sales[]
  stock_movements  stock_movements[]
  branch           branch?            @relation(fields: [branchID], references: [branchID], onUpdate: NoAction)
  roles            roles              @relation(fields: [roleID], references: [roleID], onUpdate: NoAction)

  @@index([branchID])
  @@index([roleID])
}